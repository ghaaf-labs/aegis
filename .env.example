# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY_HOURS=24

# ── API Server ───────────────────────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
RUST_LOG=aegis_api=debug,tower_http=info

# ── OpenRouter (single AI gateway, per-task model routing) ───────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Aegis
# OPENROUTER_APP_URL=https://aegis.example.com

# Per-route model slugs. ModelRoute (intent) → slug (provider/model).
# OpenRouter uses DOTTED version numbers; the `~` prefix is the
# "latest-pointer" alias (auto-tracks upstream releases). Defaults pick
# cost-conscious models — strategist (DeepSeek) and critic (OpenAI) stay
# in different families for genuine adversarial diversity on the critic
# pass. Claude slugs (e.g. `anthropic/claude-opus-4.7`,
# `~anthropic/claude-sonnet-latest`) remain valid overrides at ~10–50×
# the per-token cost; swap in via env var if budget allows.
MODEL_REGIME=qwen/qwen3.5-flash-02-23
MODEL_STRATEGIST=deepseek/deepseek-v4-pro
MODEL_CRITIC=~openai/gpt-mini-latest
MODEL_TAX=qwen/qwen3.6-flash
MODEL_COMMENTARY=~google/gemini-flash-latest

# ── Realtime ─────────────────────────────────────────────────────────────────
# How often the API fetches market snapshots and broadcasts price.tick over SSE.
# Default 30s keeps us well under CoinGecko's free-tier ~10 req/min ceiling.
# Lower for snappier ticks if you set COINGECKO_API_KEY (demo key is free and
# raises the limit to ~30 req/min).
SSE_PRICE_TICK_SECS=30

# ── Market Data ──────────────────────────────────────────────────────────────
# CoinGecko free tier (no key needed); set for higher limits.
COINGECKO_API_KEY=

# ── Real CCTP V2 + Hooks execution (Phase 2) ─────────────────────────────────
# EXECUTION_MOCK=true  → all burns/mints/settlements return deterministic fakes (safe for CI/dev)
# EXECUTION_MOCK=false → live on-chain via Alloy (requires --features real-cctp at build time
#                        + the addresses + private keys below). This path executes real
#                        depositForBurnWithCaller (with 160-byte HookExecutionPayload as messageBody),
#                        waits for Circle attestation, calls receiveMessage on the destination
#                        MessageTransmitter, and triggers RebalanceExecutor.handleReceiveMessage
#                        for atomic USDC→target swaps via Uniswap V3.
EXECUTION_MOCK=true
CCTP_ATTESTATION_URL=https://iris-api-sandbox.circle.com
CCTP_ATTESTATION_TIMEOUT_SECS=180
# 0x-prefixed hex of the EOA that submits CCTP burns / mints. Required when
# EXECUTION_MOCK=false.
CHAIN_PRIVATE_KEY_ARC=
CHAIN_PRIVATE_KEY_BASE=

# ── Sprint 3 — scheduler ─────────────────────────────────────────────────────
# How often the per-portfolio watcher ticks.
SCHEDULER_TICK_SECS=300
# Cooldown between firings for the same portfolio (in-memory).
SCHEDULER_COOLDOWN_SECS=1800
# Below this USD threshold, harvestable losses do not trigger a fresh analyze.
HARVEST_THRESHOLD_USD=50

# ── Sprint 3 — digest ────────────────────────────────────────────────────────
# Hour of day (UTC) at which the daily digest worker fires.
DIGEST_HOUR_UTC=8
# Resend API key; empty disables email send (the worker still updates last_sent_at).
RESEND_API_KEY=
DIGEST_FROM=Aegis <noreply@aegis.local>
# HMAC secret for digest unsubscribe tokens. Change in production.
DIGEST_SECRET=dev-digest-secret-change-me
# Public base URL of the frontend (used for share links, etc.).
PUBLIC_BASE_URL=http://localhost:3000
# Public base URL of this API (used in digest email unsubscribe links — the
# unsubscribe route lives on the backend, not the Next.js app).
API_BASE_URL=http://localhost:8080

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SSE_URL=http://localhost:8080/sse

# ── Real on-chain execution (CCTP V2 + Hooks + Paymaster) ────────────────────
# Flip EXECUTION_MOCK=false + build the API with --features real-cctp to enable
# live CCTP burns, attestations, and RebalanceExecutor hook swaps on Arc/Base.
# These are only required in real mode.
ARC_RPC_URL=https://testnet.arc.network
BASE_RPC_URL=https://sepolia.base.org

# Circle CCTP V2 contract addresses (testnet)
CCTP_TOKEN_MESSENGER_ARC=0x...
CCTP_TOKEN_MESSENGER_BASE=0x...
CCTP_MESSAGE_TRANSMITTER_ARC=0x...
CCTP_MESSAGE_TRANSMITTER_BASE=0x...

# Deployed RebalanceExecutor (destination hook target) on each chain
REBALANCE_EXECUTOR_ARC=0x...
REBALANCE_EXECUTOR_BASE=0x...

# Native USDC addresses (for burn/mint + hook swaps)
USDC_ARC=0x...
USDC_BASE=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# ── Nanopayments (x402) — 25bps protocol fee + referral payouts ─────────────
# Facilitator endpoint for settling signed payment authorizations.
NANOPAYMENTS_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# Your seller/receiver address that receives the 25bps protocol fees.
NANOPAYMENTS_SELLER_ADDRESS=0x...
NEXT_PUBLIC_APP_ENV=development
