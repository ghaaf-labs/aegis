# ─────────────────────────────────────────────────────────────────────────
# .env.example — committed template for fresh checkouts.
# Copy to .env, override secrets in .env.local. dotenvy order:
#   shell env  >  .env.local  >  .env  >  built-in default
# See docs/09-env-hygiene.md (coming in F-ENV-6).
# Regenerated 2026-05-16 by F-ENV-4.
# ─────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-replace-in-env-local-for-anything-non-local
JWT_EXPIRY_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=30

# ── API Server ───────────────────────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
RUST_LOG=aegis_api=debug,tower_http=info

# ── OpenRouter (single AI gateway, per-task model routing) ───────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Aegis
# OPENROUTER_APP_URL=https://aegis.example.com

# Per-route model slugs. ModelRoute (intent) → slug (provider/model).
# Override any of these without recompiling.
MODEL_REGIME=qwen/qwen3.5-flash-02-23
MODEL_STRATEGIST=deepseek/deepseek-v4-flash
MODEL_CRITIC='~openai/gpt-mini-latest'
MODEL_TAX=qwen/qwen3.6-flash
MODEL_COMMENTARY='~google/gemini-flash-latest'

# ── Realtime ─────────────────────────────────────────────────────────────────
# How often the API fetches market snapshots and broadcasts price.tick over SSE.
SSE_PRICE_TICK_SECS=30

# ── Market Data ──────────────────────────────────────────────────────────────
# CoinGecko free tier (no key needed); set for higher limits. Used only when
# PRICE_PROVIDER_PRIMARY=coingecko (rollback path).
COINGECKO_API_KEY=

# Price provider used by market_data, peg_monitor and fx. "defillama" is the
# default — no auth, ~10 req/s, batched. "pyth" is a no-auth Hermes oracle
# fallback. "coingecko" retained for rollback only. Set PRICE_PROVIDER_FALLBACK=none
# to disable the in-process circuit breaker.
PRICE_PROVIDER_PRIMARY=defillama
PRICE_PROVIDER_FALLBACK=pyth

# ── Sprint 3 — cross-chain execution ─────────────────────────────────────────
# When true, the CCTP client returns deterministic mock receipts and does not
# touch any RPC. Keep this on in CI; flip false in prod and supply the keys
# below.
EXECUTION_MOCK=true
CCTP_ATTESTATION_URL=https://iris-api-sandbox.circle.com
CCTP_ATTESTATION_TIMEOUT_SECS=180
# 0x-prefixed hex of the EOA that submits CCTP burns / mints. Required when
# EXECUTION_MOCK=false.
CHAIN_PRIVATE_KEY_ARC=
CHAIN_PRIVATE_KEY_BASE=
# Part B0 — non-custodial execution. When true, real on-chain legs are
# submitted from the *user's* Circle developer-controlled wallet (entity-secret
# signed contract-execution txs) instead of the backend EOA above. Default
# false: the EOA path stays the verified default. Requires live Circle
# developer creds + a funded user wallet to flip on.
CIRCLE_WALLET_EXEC=false

# ── Sprint 3 — scheduler ─────────────────────────────────────────────────────
# How often the per-portfolio watcher ticks.
SCHEDULER_TICK_SECS=300
# Cooldown between firings for the same portfolio (in-memory).
SCHEDULER_COOLDOWN_SECS=1800
# Below this USD threshold, harvestable losses do not trigger a fresh analyze.
HARVEST_THRESHOLD_USD=50

# ── Sprint 3 — digest ────────────────────────────────────────────────────────
# Hour of day (UTC) at which the daily digest worker fires.
DIGEST_HOUR_UTC=8
# Resend API key; empty disables email send (the worker still updates last_sent_at).
RESEND_API_KEY=
DIGEST_FROM='Aegis <noreply@aegis.local>'
# HMAC secret for digest unsubscribe tokens. Change in production.
DIGEST_SECRET=dev-only-replace-in-env-local-not-a-real-secret
# Public base URL of the frontend (used for share links, etc.).
PUBLIC_BASE_URL=http://localhost:3000
# Public base URL of this API (used in digest email unsubscribe links — the
# unsubscribe route lives on the backend, not the Next.js app).
API_BASE_URL=http://localhost:8080

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SSE_URL=http://localhost:8080/sse
NEXT_PUBLIC_APP_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# Real-execution config (set when EXECUTION_MOCK=false)
# Generated 2026-05-16 — testnet only, never use these on mainnet.
# ─────────────────────────────────────────────────────────────────────────

# RPC endpoints (defaults are public — override if rate-limited)
ARC_RPC_URL=https://rpc.testnet.arc.network
BASE_RPC_URL=https://sepolia.base.org

# USDC on each chain — Circle canonical
# Base Sepolia USDC: https://developers.circle.com/stablecoins/usdc-on-test-networks
USDC_BASE=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Arc testnet USDC: Arc is USDC-native gas; verify wrapper address from
# https://docs.arc.network/ or Circle Arc developer docs
USDC_ARC=0x3600000000000000000000000000000000000000

# USYC on Arc testnet — Hashnote deployment
# https://usyc.docs.hashnote.com/overview/smart-contracts.md
USYC_TOKEN_ARC=0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
USYC_TELLER_ARC=0x9fdF14c5B14173D74C08Af27AebFf39240dC105A
USYC_ORACLE_ARC=0x52b56c7642E71dc54714d879127d97cd0B3D4581

# CCTP V2 contracts — public Circle deployments
# Base Sepolia TokenMessenger V2: verify https://developers.circle.com/cctp/v2-supported-domains
CCTP_TOKEN_MESSENGER_BASE=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_MESSAGE_TRANSMITTER_BASE=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
# Arc testnet CCTP V2:
CCTP_TOKEN_MESSENGER_ARC=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_MESSAGE_TRANSMITTER_ARC=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# Aegis-deployed RebalanceExecutor — populated AFTER `forge create` on each chain
REBALANCE_EXECUTOR_ARC=0xca5b6e4c8c4babfbd741b21d4c521f262aa78232
REBALANCE_EXECUTOR_BASE=0xeEB1D573F13603bC075Eb8EC96CcFae80fd7A25f

# Per-chain swap venue — Uniswap V3 on Base Sepolia (needs the `real-swap` feature).
# WETH is the concrete token behind the "ETH" symbol for USDC↔token swaps.
WETH_BASE=0x4200000000000000000000000000000000000006
UNISWAP_V3_ROUTER_BASE=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4
# QuoterV2 on Base Sepolia — fill from https://docs.uniswap.org/contracts/v3/reference/deployments
UNISWAP_V3_QUOTER_BASE=0xC5290058841028F1614F3A6F0F5816cAd0df5E27

# Real, DEX-executable Base sleeves. Empty ⇒ the token stays track-only (the
# route registry fails closed). Mainnet addresses shown; for Base Sepolia,
# point at the seeded-pool token (see plan "Execution environment").
# cbBTC = BTC exposure, cbETH = staked-ETH yield, sUSDS = savings yield.
CBBTC_BASE=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
CBETH_BASE=0x2Ae3F1Ec7F1F5012CFEab0185bfc7aa3cf0DEc22
SUSDS_BASE=0x5875eee11Cf8398102FdAd704C9E96607675467a

# EUR sleeve. EURC is a freely-transferable Circle stablecoin with a real
# USDC/EURC pool on Base (Aerodrome / Uniswap V3), so the EUR sleeve executes
# via the permissionless DEX swap rather than KYB-gated Arc StableFX. Empty ⇒
# track-only (fail closed). Mainnet address shown; use the Base Sepolia faucet
# token for testnet.
EURC_BASE=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42

# USYC sleeve kill-switch. Default off: the Hashnote Teller on Arc is
# allowlist/KYB-gated (deposits revert), so USYC stays Track-only until the
# Aegis EOA is allowlisted. Flip to true only once real USYC is wired.
USYC_ENABLED=false

# Nanopayments (x402) — both default to the Arc EOA address generated above.
# Change to dedicated treasury wallets later when paying users exist.
NANOPAYMENTS_FACILITATOR_URL=https://gateway-api-testnet.circle.com
NANOPAYMENTS_SELLER_ADDRESS=0xf22C6d6047eC75c21f5845CEA7F83D740e78aa24
NANOPAYMENTS_TREASURY_ADDRESS=0xf22C6d6047eC75c21f5845CEA7F83D740e78aa24

# ─────────────────────────────────────────────────────────────────────────
# Circle Wallets API — paste your TEST_API_KEY:… here.
# Circle's W3S Programmable Wallets product uses api.circle.com for both
# sandbox and production; sandbox vs prod is keyed by the TEST_API_KEY: /
# LIVE_API_KEY: prefix on CIRCLE_API_KEY, not by a separate host.
# ─────────────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_ENV=sandbox
# Developer-controlled wallet set ID. Safe to leave empty in mock mode; real
# wallet provisioning stays pending until `.env.local` provides this plus the
# entity secret below.
CIRCLE_WALLET_SET_ID=
# Secret: put the real hex-encoded entity secret in `.env.local`, never here.
CIRCLE_ENTITY_SECRET=
# Flip to false to hit the real Circle API
MOCK_CIRCLE=true
OPENROUTER_BUDGET_GUARD_USD=0.05
# HS-6 — when true, the FX module tries Circle StableFX RFQ before falling
# back to CoinGecko spot. Default false; institutional access is KYB-gated
# and not yet open to retail Aegis. Flipping this without RFQ wiring is a
# debug log; no behavior change.
STABLEFX_INSTITUTIONAL_ACCESS=false

# ── Admin ─────────────────────────────────────────────────────────────────
# Comma-separated UUIDs that may call /admin/* endpoints.
# Empty = admin routes return 404 to all callers (safe default).
ADMIN_USER_IDS=
