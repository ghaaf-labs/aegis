# ── Build stage ───────────────────────────────────────────────────────────
FROM rust:1.94-slim-bookworm AS builder
ARG API_CARGO_FEATURES="real-cctp real-usyc"

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app/apps/api

# Cache dependencies
COPY apps/api/Cargo.toml apps/api/Cargo.lock ./
COPY apps/api/crates ./crates
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release --features "$API_CARGO_FEATURES" 2>/dev/null; rm -rf src

# Build application
COPY apps/api/ .
RUN touch src/main.rs && cargo build --release --features "$API_CARGO_FEATURES"

# ── Runtime stage ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/apps/api/target/release/aegis-api .
COPY --from=builder /app/apps/api/migrations ./migrations

EXPOSE 8080

ENTRYPOINT ["./aegis-api"]
