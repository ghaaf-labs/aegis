{
  "extends": "@aegis/config/typescript",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@aegis/shared": ["../../packages/shared/src/index.ts"],
      "@aegis/ui": ["../../packages/ui/src/index.ts"]
    },
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "jsx": "preserve"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-qa/types/**/*.ts"
  ],
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
