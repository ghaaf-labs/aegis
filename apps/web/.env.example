# ─────────────────────────────────────────────────────────────────────────
# apps/web/.env.example — committed template for the Next.js frontend.
#
# Next.js looks for `.env.local` in the project directory (this one),
# NOT the repo root. So personal overrides go in `apps/web/.env.local`
# (gitignored by Next.js's default rules + the repo `.gitignore`).
#
# Only variables prefixed `NEXT_PUBLIC_` are exposed to the browser
# bundle. Never put secrets here — server-only env reads happen in the
# Rust API instead (see root `.env.example` + `docs/09-env-hygiene.md`).
#
# Regenerated 2026-05-16 by F-ENV-7.
# ─────────────────────────────────────────────────────────────────────────

# ── Backend endpoints ─────────────────────────────────────────────────────
# Where the Next.js client (server-rendered + browser) calls the Rust API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# SSE endpoint for live decisions / peg alerts / rebalance status.
NEXT_PUBLIC_SSE_URL=http://localhost:8080/sse

# Public-facing site URL used by the share-link helper. Defaults to
# localhost:3000 if unset (see apps/web/src/lib/share.ts).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cosmetic environment label rendered in the footer/devtools panel.
NEXT_PUBLIC_APP_ENV=development

# ── Feature flags (default off; flip locally in .env.local) ──────────────
# A5 — surfaces /pricing and /settings/billing routes when "true".
# See apps/web/src/lib/flags.ts for the canonical reader.
NEXT_PUBLIC_PRICING_UI_ENABLED=false

# Mirror of the backend VOLATILE_EXECUTION_ENABLED. While off, volatile sleeves
# are tracked-not-traded (testnet AMM pools are detached from real marks); flip
# this on together with the API var on mainnet so the dashboard treats volatiles
# as tradeable (drift, badges, tower copy). See apps/web/src/lib/flags.ts.
NEXT_PUBLIC_VOLATILE_EXECUTION_ENABLED=false
