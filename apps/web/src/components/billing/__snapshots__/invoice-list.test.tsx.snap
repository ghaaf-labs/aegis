// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`<InvoiceList /> > matches snapshot when empty 1`] = `"<div class="border-border-default rounded-card bg-surface text-text-default hover:shadow-brutal transition-[box-shadow] duration-100" data-testid="invoice-list-empty"><div class="flex items-center justify-between px-4 py-3 border-b border-border-default"><span class="text-sm font-semibold text-text-hi">Invoices</span><span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-sharp font-mono text-[10px] font-semibold tracking-tight bg-text-hi text-black">FREE</span></div><div class="p-4"><p class="text-sm text-text-default">No invoices yet — you&#x27;re on the Free plan.</p><p class="text-[11px] font-mono text-text-lo mt-2">Upgrades and AUM-fee accruals will appear here after they settle.</p></div></div>"`;

exports[`<InvoiceList /> > matches snapshot when populated 1`] = `"<div class="border-border-default rounded-card bg-surface text-text-default hover:shadow-brutal transition-[box-shadow] duration-100" data-testid="invoice-list"><div class="flex items-center justify-between px-4 py-3 border-b border-border-default"><span class="text-sm font-semibold text-text-hi">Invoices</span><span class="text-[11px] font-mono text-text-lo">2 total</span></div><div class="overflow-x-auto"><table class="w-full text-xs font-mono"><thead class="text-text-lo border-b border-border-default"><tr><th class="text-left px-4 py-2 font-medium">Period</th><th class="text-left px-4 py-2 font-medium">Items</th><th class="text-right px-4 py-2 font-medium">Subtotal</th><th class="text-right px-4 py-2 font-medium">Total</th><th class="text-left px-4 py-2 font-medium">Status</th><th class="text-left px-4 py-2 font-medium">Tx</th></tr></thead><tbody><tr class="border-b border-white/5 last:border-b-0" data-invoice-id="inv-001"><td class="px-4 py-2 text-text-default">Apr 1 – May 1, 2026</td><td class="px-4 py-2 text-text-default">2</td><td class="px-4 py-2 text-right tabular-nums text-text-default">$19.00</td><td class="px-4 py-2 text-right tabular-nums text-text-hi">$23.45</td><td class="px-4 py-2"><span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-sharp font-mono text-[10px] font-semibold tracking-tight bg-accent-pnl text-black">PAID</span></td><td class="px-4 py-2"><a href="https://testnet.arcscan.app/tx/0xdeadbeef1234567890abcdef" target="_blank" rel="noopener noreferrer" class="text-accent-pnl hover:text-accent-pnl/60 underline-offset-2 hover:underline" title="0xdeadbeef1234567890abcdef">0xdead…cdef</a></td></tr><tr class="border-b border-white/5 last:border-b-0" data-invoice-id="inv-002"><td class="px-4 py-2 text-text-default">May 1 – Jun 1, 2026</td><td class="px-4 py-2 text-text-default">0</td><td class="px-4 py-2 text-right tabular-nums text-text-default">$19.00</td><td class="px-4 py-2 text-right tabular-nums text-text-hi">$19.00</td><td class="px-4 py-2"><span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-sharp font-mono text-[10px] font-semibold tracking-tight bg-risk text-black">PAST DUE</span></td><td class="px-4 py-2"><span class="text-text-lo">—</span></td></tr></tbody></table></div></div>"`;
