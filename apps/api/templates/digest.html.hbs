<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Aegis · daily digest</title>
  </head>
  <body style="margin:0;padding:0;background:#0A0A0A;color:#fff;font-family:'Inter Tight',system-ui,sans-serif">
    <table width="100%" cellpadding="0" cellspacing="0" style="background:#0A0A0A;padding:32px 0">
      <tr>
        <td align="center">
          <table width="600" cellpadding="0" cellspacing="0" style="background:#141414;border:2px solid #2A2A2A;border-radius:4px;padding:32px">
            <tr><td style="padding-bottom:16px">
              <span style="display:inline-block;background:#00E0FF;color:#000;font-weight:800;padding:4px 8px;text-transform:uppercase;letter-spacing:0.04em">Aegis</span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#8A8A8A;margin-left:8px">{{year}}</span>
            </td></tr>
            <tr><td style="font-size:24px;font-weight:700;padding-bottom:16px">Your daily portfolio digest</td></tr>
            <tr><td style="color:#B8B8B8;padding-bottom:24px;line-height:1.5">
              You have <strong style="color:#00FF88;font-family:'JetBrains Mono',monospace">{{portfolioCount}}</strong>
              active portfolio{{#if (eq portfolioCount 1)}}{{else}}s{{/if}}.
              The agent emitted <strong style="color:#00E0FF;font-family:'JetBrains Mono',monospace">{{recentDecisions}}</strong>
              decision{{#if (eq recentDecisions 1)}}{{else}}s{{/if}} in the last 24 hours.
            </td></tr>
            <tr><td style="padding-top:24px;border-top:1px solid #2A2A2A;font-size:12px;color:#8A8A8A">
              Don't want these? <a href="{{unsubscribeUrl}}" style="color:#00E0FF;text-decoration:underline">Unsubscribe</a>
            </td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
