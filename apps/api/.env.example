DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis
JWT_SECRET=dev-secret-change-in-production-32chars
JWT_EXPIRY_HOURS=24
API_PORT=8080
API_HOST=0.0.0.0
RUST_LOG=aegis_api=debug,tower_http=info
# AI gateway is OpenRouter (per-task model routing), never OpenAI direct.
# See the repo-root .env.example for the full, canonical list incl. MODEL_* slugs.
OPENROUTER_API_KEY=sk-or-...
COINGECKO_API_KEY=

# Trader Joe Liquidity Book (LB v2.2) swap venue on Avalanche. Empty ⇒ Avax
# swaps report NeedsAddress and fail closed (AvaxFuji stays non-execution).
TRADER_JOE_LB_ROUTER_AVAX=
TRADER_JOE_LB_QUOTER_AVAX=
