{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "ignoreBinaries": ["scripts/check-branch-name.sh"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,route,error,not-found}.{ts,tsx}",
        "src/lib/api.ts",
        "src/lib/sse.ts",
        "src/lib/utils.ts",
        "src/lib/explore-data.ts",
        "src/types/index.ts",
        "src/stores/portfolio.ts",
        "src/components/wallet/faucet-button.tsx",
        "next.config.{js,ts,mjs}",
        "tailwind.config.{ts,js}",
        "postcss.config.{js,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss-animate"]
    },
    "packages/shared": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@aegis/config"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@aegis/config",
        "@radix-ui/react-slot",
        "class-variance-authority"
      ]
    },
    "packages/config": {
      "ignoreDependencies": [
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-next",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks"
      ]
    }
  }
}
